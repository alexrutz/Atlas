# =============================================================================
# Atlas RAG System - Environment Variables
# =============================================================================
# These defaults allow `docker compose up` to work immediately after cloning.
# For production, change DB_PASSWORD and AUTH_SECRET_KEY to secure values.
# =============================================================================

# PostgreSQL password
DB_PASSWORD=atlas

# JWT secret key for authentication (generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# Default admin password on first start
ADMIN_DEFAULT_PASSWORD=admin

# =============================================================================
# Hugging Face Token (optional, required for gated models)
# =============================================================================
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=

# =============================================================================
# LLM - llama.cpp CUDA server (port 8080)
# =============================================================================
# Model: unsloth/Qwen3.6-35B-A3B-GGUF (Q5_K_XL, ~26.6 GB).
# Place the GGUF file in ../models/ before first start (see scripts/pull-models.sh).
# -1 = offload all layers to GPU
LLM_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf
LLM_N_GPU_LAYERS=-1
LLM_CTX_SIZE=32768
# Reasoning format: "auto" detects from model template (Qwen3 uses <think> tags),
# "deepseek" forces <think> tag parsing, "none" disables.
LLM_REASONING_FORMAT=auto
# Reasoning budget: -1 = unrestricted, 0 = no thinking, N>0 = max N thinking tokens
LLM_REASONING_BUDGET=-1

# =============================================================================
# Embedding - llama-server CUDA (port 8081)
# =============================================================================
# Model: Qwen/Qwen3-Embedding-4B-GGUF (Q6_K, ~3.31 GB).
# Output: 2560-dimensional embeddings.
EMBED_MODEL_FILE=Qwen3-Embedding-4B-Q6_K.gguf
EMBED_CTX_SIZE=1024
EMBED_BATCH_SIZE=1024

# =============================================================================
# Reranker - llama-server CUDA in --reranking mode (port 8082)
# =============================================================================
# Model: Voodisss/Qwen3-Reranker-4B-GGUF-llama_cpp (Q6_K, ~3.31 GB).
# Community GGUF of Qwen/Qwen3-Reranker-4B prepared for llama.cpp.
RERANK_MODEL_FILE=Qwen3-Reranker-4B-Q6_K.gguf
RERANK_CTX_SIZE=4096

# =============================================================================
# Docling API Configuration
# =============================================================================

# --- Server-level settings (passed to docling-serve container) ---------------

# OCR engine: "easyocr" (GPU-accelerated), "rapidocr", "tesseract", "ocrmac"
DOCLING_OCR_ENGINE=rapidocr

# Accelerator device for layout/table/OCR models: "auto", "cpu", "cuda", "mps"
DOCLING_ACCELERATOR_DEVICE=cpu
DOCLING_FLASH_ATTENTION=false

# GPU batch sizes (increase on high-VRAM GPUs for throughput)
DOCLING_OCR_BATCH_SIZE=8
DOCLING_LAYOUT_BATCH_SIZE=8
DOCLING_TABLE_BATCH_SIZE=8

# Torch CPU threads (for CPU-bound model inference)
DOCLING_NUM_THREADS=12

# Local engine workers & model sharing (share_models=true saves VRAM)
DOCLING_WORKERS=1
DOCLING_SHARE_MODELS=true

# Per-document timeout (seconds)
DOCLING_DOCUMENT_TIMEOUT=600
# Max wait for synchronous API responses (seconds)
DOCLING_MAX_SYNC_WAIT=600

# Resource limits (leave empty for unlimited, docling-serve defaults to no limit)
# DOCLING_MAX_NUM_PAGES=1000
# DOCLING_MAX_FILE_SIZE=100000000

# Model warmup on container start (avoids cold-start latency)
DOCLING_WARMUP=true

# Log level: debug, info, warning, error
DOCLING_LOG_LEVEL=info

# --- Per-request defaults (passed to backend, sent in API calls) -------------

# OCR for scanned documents and images
DOCLING_DO_OCR=true
# Comma-separated OCR languages: "de,en" (empty = auto-detect)
DOCLING_OCR_LANG=

# Table structure recognition
DOCLING_DO_TABLE_STRUCTURE=true
# "fast" (TableFormer-fast) or "accurate" (slower, better)
DOCLING_TABLE_MODE=accurate

# Code block detection
DOCLING_DO_CODE_ENRICHMENT=false

# Scale factor for rasterized page images
DOCLING_IMAGES_SCALE=2.0
